rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks if the user is authenticated and matches the owner of the booking
    function isBookingOwner(bookingData) {
      return isAuthenticated() && (
        bookingData.userId == request.auth.uid ||
        bookingData.userEmail == request.auth.token.email
      );
    }

    // Check if user has an active/confirmed booking for the specific busId
    // Since Firestore Rules do not support querying collections, we recommend storing a user's active
    // bookings in a subcollection under the user document, or as a field list, or querying via a deterministic path:
    // e.g. /user_booked_buses/$(request.auth.uid)_$(busId)
    function hasBookedBus(busId) {
      return isAuthenticated() && (
        // 1. Check if user's ID matches the owner of a booking with this busId.
        // In client-side code, user queries their own bookings. For individual document access on bus_locations:
        // If a deterministic document exists linking the user to the bus:
        exists(/databases/$(database)/documents/user_booked_buses/$(request.auth.uid + '_' + busId))
      );
    }

    // Users Collection rules
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Buses Collection rules
    match /buses/{busId} {
      allow read: if true; // Publicly readable for searching
      allow write: if isAdmin();
    }

    // Bookings Collection rules
    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && isBookingOwner(resource.data));
      allow update, delete: if isAdmin() || (isAuthenticated() && isBookingOwner(resource.data));
    }

    // Bus Locations Collection rules
    match /bus_locations/{busId} {
      // Admins can read all locations. Users can read location if they have booked the bus.
      allow read: if isAdmin() || 
                  (isAuthenticated() && (
                    // Fallback to basic auth check if strict booking-level access is bypassed
                    // or checking deterministic booking relation:
                    hasBookedBus(busId)
                  ));
      
      // Only admins or automated bus/driver tracking systems can write locations
      allow write: if isAdmin();
    }
  }
}
